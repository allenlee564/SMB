[Unit]
Description=Blue AI DDoS detector
Wants=network-online.target
After=network-online.target ollama.service blueai-firewall-restore.service

[Service]
Type=simple
User=blueai
Group=blueai
ExecStart=/usr/bin/python3 /opt/blue-ai/app/ddos_detector.py
Restart=on-failure
RestartSec=5s
# analyzer.py uses the narrowly scoped sudoers rule for blueai-autoblock.
# NoNewPrivileges must remain disabled or sudo cannot cross that boundary.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/blue-ai/events /opt/blue-ai/logs /opt/blue-ai/state

[Install]
WantedBy=multi-user.target
